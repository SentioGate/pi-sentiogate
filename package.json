{
  "name": "@sentiogate/pi-provider",
  "version": "0.1.1",
  "description": "SentioGate provider for the Pi coding agent: route Pi through an OpenAI-compatible LLM router with zero markup on your own keys.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "SentioGate <187725357+HISHAMJOTTERREV@users.noreply.github.com>",
  "homepage": "https://github.com/SentioGate/pi-sentiogate#readme",
  "keywords": [
    "pi-package",
    "pi",
    "sentiogate",
    "llm-router",
    "openai-compatible",
    "byok"
  ],
  "files": [
    "extensions",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --input-type=module -e 'import(\"./extensions/sentiogate.js\")'"
